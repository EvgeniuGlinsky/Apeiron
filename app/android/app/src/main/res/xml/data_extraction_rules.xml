<?xml version="1.0" encoding="utf-8"?>
<!--
  None of the app's data leaves the device.

  The master key sits in this phone's hardware store and is never exported.
  Any copy of the database that ends up outside the device is undecryptable — and
  yet stays lying where it can be obtained. That is why both sections are excluded
  entirely: cloud-backup (the cloud) and device-transfer (transfer to a new phone).

  Read starting from API 31. On 28-30 the same role is played by
  android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
