# Line-ending normalisation. Without it a Windows working copy produces CRLF,
# any other contributor LF, and every file looks changed in its entirety.
* text=auto eol=lf

# Windows-specific files keep CRLF: otherwise MSVC tools break.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.rc    text eol=crlf
*.manifest text eol=crlf

# Binary — do not touch.
*.png   binary
*.jpg   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.apk   binary
*.so    binary
*.dll   binary
*.jar   binary
*.keystore binary
*.jks   binary
