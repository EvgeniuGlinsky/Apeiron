# Нормализация переносов строк. Без этого Windows-рабочая копия даёт CRLF,
# а любой другой участник — LF, и каждый файл выглядит изменённым целиком.
* text=auto eol=lf

# Windows-специфичное оставляем с CRLF: иначе ломаются инструменты MSVC.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf
*.rc    text eol=crlf
*.manifest text eol=crlf

# Бинарное — не трогать.
*.png   binary
*.jpg   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.apk   binary
*.so    binary
*.dll   binary
*.jar   binary
*.keystore binary
*.jks   binary
